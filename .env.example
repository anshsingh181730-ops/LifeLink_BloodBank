# LifeLink Platform Environment Variables
# Google OAuth 2.0 Client ID for GIS Sign-In (Optional / Configurable)
# Setup at: https://console.cloud.google.com/apis/credentials
# Ensure 'http://localhost:3000' is in Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Clinical AI Assistant LLM Provider (Choose any ONE, or leave blank to use free built-in inference):
# Option A: Google Gemini API (Recommended - Get free key at https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI API (Get key at https://platform.openai.com/api-keys)
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# Option C: Groq Cloud API (Get free key at https://console.groq.com/keys)
# VITE_GROQ_API_KEY=your_groq_api_key_here
